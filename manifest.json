{
  "manifest_version": 3,
  "name": "Farbe",
  "version": "2.1",
  "description": "TaxiTabs, MakePiece, DiverseObserver, PageNoteを統合したスーパーアプリ",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "contextMenus",
    "notifications",
    "sidePanel",
    "alarms"
  ],
  "host_permissions": ["https://*/*", "http://*/*"],
  "icons": {
    "128": "icon.png"
  },
  "background": {
    "service_worker": "js/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://lms2.s-diverse.com/*"],
      "js": ["js/content/diverse-observer.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Farbe"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+M",
        "mac": "Alt+M"
      },
      "description": "Farbe サイドパネルを開く"
    },
    "open_page_note": {
      "suggested_key": {
        "default": "Alt+N",
        "mac": "Alt+N"
      },
      "description": "Page Note を開く"
    }
  }
}
